          "name": "TC-AUTH-API-001 | POST Login — valid credentials",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC-AUTH-API-001 | Status code is 200', () => { pm.response.to.have.status(200); });",
                  "pm.test('TC-AUTH-API-001 | Response has token field', () => { pm.expect(pm.response.json()).to.have.property('token'); });",
                  "pm.test('TC-AUTH-API-001 | Token is a non-empty string', () => { pm.expect(pm.response.json().token).to.be.a('string').and.not.empty; });",
                  "pm.test('TC-AUTH-API-001 | Content-Type is application/json', () => { pm.response.to.have.header('Content-Type'); });",
                  "pm.test('TC-AUTH-API-001 | Response time is under 3000ms', () => { pm.expect(pm.response.responseTime).to.be.below(3000); });",
                  "const token = pm.response.json().token; pm.collectionVariables.set('authToken', token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"eve.holt@reqres.in\",\n  \"password\": \"cityslicka\"\n}"
            }
